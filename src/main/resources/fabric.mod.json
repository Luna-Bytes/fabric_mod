{
	"schemaVersion": 1,
	"id": "lunabytes",
	"version": "${version}",
	"name": "lunabytes",
	"description": "Recreation for Matcha Flavored as a Mod instead of an datapack",
	"authors": [
		"LunaBytes"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/lunabytes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.lunabytes.Lunabytes"
		],
		"client": [
			"dev.lunabytes.client.LunabytesClient"
		],
		"fabric-datagen": [
			"dev.lunabytes.datagen.LunaBytesGenerator",
			"dev.lunabytes.client.datagen.LunaBytesClientGenerator"
		]
	},
	"mixins": [
		"lunabytes.mixins.json",
		{
			"config": "lunabytes.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}